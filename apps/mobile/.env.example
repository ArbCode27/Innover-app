EXPO_PUBLIC_API_URL=https://innover-flow.vercel.app
EXPO_PUBLIC_APP_CHANNEL_SECRET=

# Copia este archivo a .env en apps/mobile. app.config.js lo carga al arrancar.
# APK preview (EAS): el mismo valor en expo.dev → Environment variables →
# preview y production. Sin eso el login del APK falla. No lo subas a git.

# Alias legado de EXPO_PUBLIC_API_URL (se ignora si la de arriba está definida).
EXPO_PUBLIC_API_BASE_URL=

# Opcional. El login de abonado no pide slug.
EXPO_PUBLIC_ORGANIZATION_SLUG=

# Legado (no usar para REST de negocio). Realtime llega en login.realtime.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ATTACHMENTS_BUCKET=app-attachments
